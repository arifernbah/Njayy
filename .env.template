# ========================================
# ARIF BOT - ICT STRATEGY CONFIGURATION
# ========================================

# 🔑 API CREDENTIALS
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_key_here
BINANCE_API_SECRET=your_binance_secret_key_here

# 📱 TELEGRAM CONFIGURATION
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ⚙️ TRADING PARAMETERS
DEFAULT_INTERVAL=15m
LEVERAGE=5
MAX_DAILY_TRADES=6
MAX_OPEN_POSITIONS=2
MAX_CONCURRENT_TRADES=2
MAX_DRAWDOWN=10.0

# 💰 RISK MANAGEMENT
DEFAULT_RISK=1.0
REDUCED_RISK=0.5
MINIMUM_RISK=0.25

# 🎯 SIGNAL FILTERS
MIN_SIGNAL_STRENGTH=70
MIN_BIAS_STRENGTH=35
MIN_REGIME_SCORE=55
MIN_QUALITY_SCORE=70

# 📊 VOLATILITY RANGE
VOL_RANGE_MIN=0.4
VOL_RANGE_MAX=1.8

# 🕒 SESSION TIMES (WIB) - UPDATED FROM UTC
LONDON_START=14:00      # 07:00 UTC + 7 = 14:00 WIB
LONDON_END=23:00        # 16:00 UTC + 7 = 23:00 WIB
NY_START=21:00          # 14:00 UTC + 7 = 21:00 WIB
NY_END=06:00            # 23:00 UTC + 7 = 06:00 WIB (next day)
ASIAN_START=07:00       # 00:00 UTC + 7 = 07:00 WIB
ASIAN_END=16:00         # 09:00 UTC + 7 = 16:00 WIB

# 🎯 KILLZONE TIMES (WIB) - UPDATED FROM UTC
KILLZONE_ASIA_LONDON_START=15:00  # 08:00 UTC + 7 = 15:00 WIB
KILLZONE_ASIA_LONDON_END=01:00    # 18:00 UTC + 7 = 01:00 WIB (next day)
KILLZONE_NY_START=02:00           # 19:00 UTC + 7 = 02:00 WIB (next day)
KILLZONE_NY_END=05:00             # 22:00 UTC + 7 = 05:00 WIB (next day)

# 📈 SESSION MINIMUM SCORES
LONDON_MIN_SCORE=70
NY_MIN_SCORE=70
ASIAN_MIN_SCORE=80

# 🔄 AUTO PAIR CONFIGURATION
USE_TOP_VOLUME_PAIRS=True
TOP_VOLUME_COUNT=10
VOLUME_TIMEFRAME=24h

# 📝 MANUAL TRADING PAIRS (if USE_TOP_VOLUME_PAIRS=False)
TRADING_PAIRS=BTCUSDT,ETHUSDT,ADAUSDT,BNBUSDT,SOLUSDT,XRPUSDT

# ⏱️ TIMEFRAMES
HTF1=Daily
HTF2=4H
ENTRY_TF=15M

# 🎯 PERFORMANCE TARGETS
TARGET_WIN_RATE=60.0
SIGNAL_TARGET_MIN=3
SIGNAL_TARGET_MAX=6

# 🔧 BOT SETTINGS
LOOP_INTERVAL=60
ENABLE_TELEGRAM=True
LOG_LEVEL=INFO

# 🔄 RETRY CONFIGURATION
BINANCE_MAX_RETRIES=5
BINANCE_RETRY_DELAY=2.0

# ========================================
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in your API credentials
# 3. Adjust parameters as needed
# 4. Save and restart bot
# ========================================