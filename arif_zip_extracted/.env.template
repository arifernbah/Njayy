# === Binance API Configuration ===
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_secret

# === Telegram Bot Configuration ===
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
ENABLE_TELEGRAM=True

# === Trading Settings ===
DEFAULT_RISK=1           # Risk per trade in percent (e.g. 1 = 1%)
REDUCED_RISK=0.5         # Risk per trade if drawdown (in percent)
MINIMUM_RISK=0.25        # Minimum risk per trade (in percent)
LEVERAGE=5               # Leverage to use (e.g. 5 = 5x)
MAX_DAILY_TRADES=7       # Max trades per day
MAX_CONCURRENT_TRADES=2  # Max open trades at once
MAX_DRAWDOWN=10          # Max drawdown in percent

# === Signal Filters ===
MIN_SIGNAL_STRENGTH=70   # Minimum signal strength (0-100)
MIN_BIAS_STRENGTH=35     # Minimum bias strength (0-100)
MIN_REGIME_SCORE=55      # Minimum regime score (0-100)
MIN_QUALITY_SCORE=70     # Minimum quality score (0-100) for valid entry
VOL_RANGE_MIN=0.4        # Minimum volatility
VOL_RANGE_MAX=1.8        # Maximum volatility

# === Session Settings (UTC) ===
LONDON_START=07:00
LONDON_END=16:00
NY_START=14:00
NY_END=23:00
ASIAN_START=00:00
ASIAN_END=09:00
LONDON_MIN_SCORE=70
NY_MIN_SCORE=70
ASIAN_MIN_SCORE=80

# === Performance Targets ===
TARGET_WIN_RATE=60       # Target win rate in percent
SIGNAL_TARGET_MIN=3      # Minimum signals per day
SIGNAL_TARGET_MAX=6      # Maximum signals per day

# === Timeframes ===
HTF1=Daily
HTF2=4H
ENTRY_TF=15M

# === Top Volume Settings ===
USE_TOP_VOLUME_PAIRS=True
TOP_VOLUME_COUNT=10
VOLUME_TIMEFRAME=24h

# === Binance API Retry Settings ===
BINANCE_MAX_RETRIES=5
BINANCE_RETRY_DELAY=2.0

# === Trading Pairs (comma separated, will be overridden if USE_TOP_VOLUME_PAIRS=True) ===
TRADING_PAIRS=BTCUSDT,ETHUSDT,ADAUSDT,BNBUSDT,SOLUSDT,XRPUSDT

# === VPN/Network (optional) ===
# VPN_CONFIG_FILE=path_to_ovpn_file