# ICT Trading Bot ENV Template

# Binance API
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Telegram
TELEGRAM_TOKEN=your_telegram_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
ENABLE_TELEGRAM=True

# Trading Parameters
MAX_DAILY_TRADES=6           # Maksimal entry per hari
MAX_OPEN_POSITIONS=2         # Maksimal posisi aktif bersamaan
MAX_DRAWDOWN=10.0            # Maksimal drawdown (%)
DEFAULT_RISK=0.01            # Default risk per trade (0.01 = 1%)
REDUCED_RISK=0.005           # Risk saat drawdown (0.005 = 0.5%)
MINIMUM_RISK=0.002           # Risk minimum (0.002 = 0.2%)
LEVERAGE=5                   # Leverage default

# Signal Filters
MIN_SIGNAL_STRENGTH=70       # Minimal signal strength
MIN_BIAS_STRENGTH=35         # Minimal bias strength
min_quality_score=70         # Minimal quality score sinyal

# Timeframe & Pair
ENTRY_TF=15M                 # Timeframe entry (misal: 15M, 1H)
TRADING_PAIRS=BTCUSDT,ETHUSDT,BNBUSDT  # Pair yang di-scan, pisahkan dengan koma

# Killzone (jam trading aktif, format 24 jam)
KILLZONE_ASIA_LONDON_START=08:00
KILLZONE_ASIA_LONDON_END=18:00
KILLZONE_NY_START=19:00
KILLZONE_NY_END=22:00

# Lain-lain
SIGNAL_TARGET_MIN=3          # Target sinyal minimum per hari
SIGNAL_TARGET_MAX=6          # Target sinyal maksimum per hari
BINANCE_RETRY_DELAY=2.0      # Delay retry API Binance (detik)

# Logging
LOG_LEVEL=INFO

# Jangan lupa rename file ini menjadi .env dan isi semua parameter sebelum menjalankan bot!